@{
    ViewData["Title"] = "Configuración";
}
<section class="page-heading"><div><span class="eyebrow">ADMINISTRADOR</span><h1>Configuración del negocio</h1><p>Precios, costos, fletes y reglas operativas usadas por el motor de Google Apps Script.</p></div><button class="btn btn-ghost" id="forceSync" type="button">Sincronizar ahora</button></section>
<form id="configForm" class="config-layout">
    <section class="card"><div class="card-header"><div><span class="eyebrow">PRECIOS</span><h3>Producto y venta</h3></div></div><div class="form-grid two"><label class="field"><span>Producto</span><input id="producto"/></label><label class="field"><span>UM</span><input id="um"/></label><label class="field"><span>Precio 1 unidad</span><input id="precio1" type="number" step="0.01"/></label><label class="field"><span>Precio 2 unidades</span><input id="precio2" type="number" step="0.01"/></label><label class="field"><span>Precio 3 unidades</span><input id="precio3" type="number" step="0.01"/></label><label class="field"><span>Precio unidad extra</span><input id="precioExtra" type="number" step="0.01"/></label><label class="field"><span>Costo unitario</span><input id="costoUnitario" type="number" step="0.01"/></label></div></section>
    <section class="card"><div class="card-header"><div><span class="eyebrow">OPERACIÓN</span><h3>Fletes y automatizaciones</h3></div></div><div class="form-grid two"><label class="field"><span>Flete Lima</span><input id="fleteLima" type="number" step="0.01"/></label><label class="field"><span>Flete Provincia</span><input id="fleteProvincia" type="number" step="0.01"/></label><label class="field"><span>Máximo de intentos</span><input id="maxIntentos" type="number" min="1"/></label><label class="field"><span>Días espera adelanto</span><input id="diasEsperaAdelanto" type="number" min="1"/></label><label class="field"><span>Minutos de bloqueo</span><input id="minutosBloqueo" type="number" min="1"/></label><label class="field"><span>Horas de sesión</span><input id="horasSesion" type="number" min="1"/></label></div></section>
    <div class="config-submit"><button class="btn btn-primary btn-lg" type="submit">Guardar configuración</button></div>
</form>
@section Scripts { <script src="~/js/admin-config.js" asp-append-version="true"></script> }
