@{
    ViewData["Title"] = "Configuración";
}
<section class="page-heading">
    <div>
        <span class="eyebrow">ADMINISTRADOR</span>
        <h1>Configuración del negocio</h1>
        <p>Estos valores alimentan directamente los montos, fletes, costos de producción, utilidad y proyecciones del sistema.</p>
    </div>
    <button class="btn btn-ghost" id="forceSync" type="button">Sincronizar Hoja 1 → Gestión</button>
</section>

<section class="card" style="margin-bottom:1rem">
    <div class="card-header">
        <div>
            <span class="eyebrow">LÓGICA COMERCIAL</span>
            <h3>Reglas originales conservadas</h3>
        </div>
    </div>
    <p class="muted">El monto se calcula con la <strong>cantidad real</strong>: 1 unidad usa Precio 1; 2 unidades Precio 2; 3 unidades Precio 3; desde la cuarta se suma Precio unidad extra por cada unidad adicional. El costo unitario se usa para utilidad/proyección y los fletes se aplican según LIMA o PROVINCIA.</p>
</section>

<form id="configForm" class="config-layout">
    <section class="card">
        <div class="card-header"><div><span class="eyebrow">PRECIOS</span><h3>Producto y venta</h3></div></div>
        <div class="form-grid two">
            <label class="field"><span>Producto</span><input id="producto"/></label>
            <label class="field"><span>UM</span><input id="um"/></label>
            <label class="field"><span>Precio 1 unidad (S/)</span><input id="precio1" type="number" min="0" step="0.01"/></label>
            <label class="field"><span>Precio 2 unidades (S/)</span><input id="precio2" type="number" min="0" step="0.01"/></label>
            <label class="field"><span>Precio 3 unidades (S/)</span><input id="precio3" type="number" min="0" step="0.01"/></label>
            <label class="field"><span>Precio unidad extra (S/)</span><input id="precioExtra" type="number" min="0" step="0.01"/></label>
            <label class="field"><span>Costo unitario producción (S/)</span><input id="costoUnitario" type="number" min="0" step="0.01"/></label>
        </div>
    </section>

    <section class="card">
        <div class="card-header"><div><span class="eyebrow">OPERACIÓN</span><h3>Fletes y automatizaciones</h3></div></div>
        <div class="form-grid two">
            <label class="field"><span>Flete Lima (S/)</span><input id="fleteLima" type="number" min="0" step="0.01"/></label>
            <label class="field"><span>Flete Provincia (S/)</span><input id="fleteProvincia" type="number" min="0" step="0.01"/></label>
            <label class="field"><span>Tipo de cambio publicidad US$ → S/</span><input id="tipoCambioPublicidad" type="number" min="0.01" step="0.01"/></label>
            <label class="field"><span>Máximo de intentos sin respuesta</span><input id="maxIntentos" type="number" min="1"/></label>
            <label class="field"><span>Días de espera de adelanto</span><input id="diasEsperaAdelanto" type="number" min="1"/></label>
            <label class="field"><span>Minutos de bloqueo de atención</span><input id="minutosBloqueo" type="number" min="1"/></label>
            <label class="field"><span>Horas de sesión</span><input id="horasSesion" type="number" min="1"/></label>
        </div>
    </section>

    <div class="config-submit">
        <button class="btn btn-primary btn-lg" type="submit">Guardar y recalcular pedidos</button>
    </div>
</form>
@section Scripts { <script src="~/js/admin-config.js" asp-append-version="true"></script> }
