@{
    ViewData["Title"] = "Publicidad";
}
<section class="page-heading"><div><span class="eyebrow">ADMINISTRADOR</span><h1>Gastos de publicidad</h1><p>Registra Facebook y TikTok para que el resumen y la proyección calculen la rentabilidad real.</p></div><button class="btn btn-primary" id="newAdvertising" type="button">Nuevo gasto</button></section>
<div class="admin-split"><section class="card"><div class="card-header"><div><span class="eyebrow">REGISTRO</span><h3 id="advertisingFormTitle">Agregar gasto</h3></div></div><form id="advertisingForm" class="form-stack"><input id="advertisingId" type="hidden"/><label class="field"><span>Fecha</span><input id="advertisingDate" type="date" required/></label><div class="form-grid two"><label class="field"><span>Facebook US$</span><input id="fbUsd" type="number" min="0" step="0.01" value="0"/></label><label class="field"><span>Facebook S/</span><input id="fbPen" type="number" min="0" step="0.01" value="0"/></label><label class="field"><span>TikTok S/</span><input id="ttPen" type="number" min="0" step="0.01" value="0"/></label><label class="field"><span>Total S/</span><input id="totalPen" disabled/></label></div><label class="field"><span>Observación</span><textarea id="advertisingNote" rows="3"></textarea></label><div class="form-actions"><button class="btn btn-ghost" id="clearAdvertising" type="button">Limpiar</button><button class="btn btn-primary" type="submit">Guardar gasto</button></div></form></section><section class="card table-card"><div class="card-header"><div><span class="eyebrow">HISTORIAL</span><h3>Gastos registrados</h3></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Fecha</th><th>FB US$</th><th>FB S/</th><th>TikTok S/</th><th>Total S/</th><th>Observación</th><th></th></tr></thead><tbody id="advertisingBody"></tbody></table></div></section></div>
@section Scripts { <script src="~/js/admin-advertising.js" asp-append-version="true"></script> }
