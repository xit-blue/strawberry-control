@{
    ViewData["Title"] = "Publicidad";
}
<section class="page-heading"><div><span class="eyebrow">ADMINISTRADOR</span><h1>Gastos de publicidad</h1><p>Registra Facebook y TikTok para que el resumen y la proyección calculen la rentabilidad real.</p></div><button class="btn btn-primary" id="newAdvertising" type="button">Nuevo gasto</button></section>
<div class="admin-split"><section class="card"><div class="card-header"><div><span class="eyebrow">REGISTRO</span><h3 id="advertisingFormTitle">Agregar gasto</h3></div></div><form id="advertisingForm" class="form-stack"><input id="advertisingId" type="hidden"/><label class="field"><span>Fecha</span><input id="advertisingDate" type="date" required/></label><div class="form-grid two"><label class="field"><span>Facebook US$</span><input id="fbUsd" type="number" min="0" step="0.01" value="0"/></label><label class="field"><span>Facebook S/ (automático)</span><input id="fbPen" type="number" min="0" step="0.01" value="0" readonly/></label><label class="field"><span>TikTok S/</span><input id="ttPen" type="number" min="0" step="0.01" value="0"/></label><label class="field"><span>Total S/</span><input id="totalPen" disabled/></label></div><p class="muted" id="exchangeRateNote" style="margin:-.25rem 0 .25rem">Conversión automática: Facebook US$ × 3.50 = Facebook S/</p><label class="field"><span>Observación</span><textarea id="advertisingNote" rows="3"></textarea></label><div class="form-actions"><button class="btn btn-ghost" id="clearAdvertising" type="button">Limpiar</button><button class="btn btn-primary" type="submit">Guardar gasto</button></div></form></section><section class="card table-card"><div class="card-header"><div><span class="eyebrow">HISTORIAL</span><h3>Gastos registrados</h3></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Fecha</th><th>FB US$</th><th>FB S/</th><th>TikTok S/</th><th>Total S/</th><th>Observación</th><th></th></tr></thead><tbody id="advertisingBody"></tbody></table></div></section></div>

<section class="card advertising-chart-card">
  <div class="card-header advertising-chart-header">
    <div>
      <span class="eyebrow">FLUJO DE INVERSIÓN</span>
      <h3>Gasto diario de Facebook en US$</h3>
      <p class="muted">Eje X: días · Eje Y: gasto publicitario en dólares.</p>
    </div>
    <div class="advertising-chart-metrics">
      <div><span>Total periodo</span><strong id="chartTotalUsd">US$ 0.00</strong></div>
      <div><span>Promedio diario</span><strong id="chartAverageUsd">US$ 0.00</strong></div>
      <div><span>Mayor gasto</span><strong id="chartMaxUsd">US$ 0.00</strong></div>
    </div>
  </div>
  <div class="advertising-chart-scroll" id="advertisingChartScroll">
    <div id="advertisingChart" class="advertising-chart" role="img" aria-label="Gráfico lineal de gasto diario de Facebook en dólares">
      <div class="chart-empty">Cargando gráfico…</div>
    </div>
  </div>
</section>

@section Scripts { <script src="~/js/admin-advertising.js" asp-append-version="true"></script> }
