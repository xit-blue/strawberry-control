@{
    ViewData["Title"] = "Usuarios";
}
<section class="page-heading"><div><span class="eyebrow">ADMINISTRADOR</span><h1>Usuarios del sistema</h1><p>Administra hasta 10 trabajadores activos. El Administrador principal se gestiona desde Apps Script.</p></div><button class="btn btn-primary" id="newUser" type="button">Crear trabajador</button></section>
<section class="card table-card"><div class="table-toolbar"><div><strong id="usersCount">0 usuarios</strong><span>1 Administrador + hasta 10 trabajadores activos</span></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Último acceso</th><th></th></tr></thead><tbody id="usersBody"></tbody></table></div></section>
<dialog id="userDialog" class="app-dialog"><form id="userForm"><div class="dialog-header"><div><span class="eyebrow">TRABAJADOR</span><h3>Crear usuario</h3></div><button class="icon-btn" type="button" data-close-dialog>×</button></div><label class="field"><span>Usuario</span><input id="newUsername" required/></label><label class="field"><span>Nombre</span><input id="newName" required/></label><label class="field"><span>Contraseña inicial</span><input id="newPassword" type="password" minlength="8" required/></label><div class="dialog-actions"><button class="btn btn-ghost" type="button" data-close-dialog>Cancelar</button><button class="btn btn-primary" type="submit">Crear trabajador</button></div></form></dialog>
<dialog id="passwordDialog" class="app-dialog"><form id="passwordForm"><input id="passwordUserId" type="hidden"/><div class="dialog-header"><div><span class="eyebrow">SEGURIDAD</span><h3>Restablecer contraseña</h3></div><button class="icon-btn" type="button" data-close-dialog>×</button></div><label class="field"><span>Nueva contraseña</span><input id="resetPasswordValue" type="password" minlength="8" required/></label><div class="dialog-actions"><button class="btn btn-ghost" type="button" data-close-dialog>Cancelar</button><button class="btn btn-primary" type="submit">Actualizar contraseña</button></div></form></dialog>
@section Scripts { <script src="~/js/admin-users.js" asp-append-version="true"></script> }
